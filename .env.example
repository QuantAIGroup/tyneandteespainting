# ------------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local to GitHub – it contains secret keys.
# On Vercel, add these in Project → Settings → Environment Variables.
# ------------------------------------------------------------------

# Your live website address (no trailing slash). Used for SEO and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.co.uk

# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The PUBLIC key (called "publishable" or "anon"). Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The SECRET key (called "secret" or "service_role"). Server only – keep private!
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional: email notifications for new enquiries via https://resend.com
# RESEND_API_KEY=re_xxx
# NOTIFICATION_EMAIL_TO=you@yourdomain.co.uk
# NOTIFICATION_EMAIL_FROM="Website <enquiries@yourdomain.co.uk>"

# ------------------------------------------------------------------
# Stripe – 50% booking deposits (https://dashboard.stripe.com)
# Start with TEST keys (sk_test_…). Switch to live keys only after testing.
# ------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
# From Developers → Webhooks → your endpoint → "Signing secret"
# (when testing locally, the whsec_… printed by `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Set to true ONLY after Apple Pay / Google Pay are switched on in Stripe → Settings → Payment methods
# (and your Stripe account is activated). Until then the site only mentions card payments.
STRIPE_WALLETS_ENABLED=false

# ------------------------------------------------------------------
# Painter platform
# 32 random bytes, base64. Encrypts painter UTRs, NI numbers and bank details.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEEP A COPY in your password manager – if lost, stored details can't be read.
# ------------------------------------------------------------------
PAINTER_DATA_ENCRYPTION_KEY=
